# Life OS — required environment variables
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the publishable key belongs here — never the secret/service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Non-public: used by tooling (supabase CLI type generation), not the app
SUPABASE_PROJECT_ID=<project-ref>

# Optional. Origin used to build password-reset links. Vercel's own env vars
# cover the deployed case; set this only to pin a custom domain. Whatever it
# resolves to must also be in Supabase → Authentication → URL Configuration →
# Redirect URLs, or GoTrue discards it and falls back to Site URL.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
